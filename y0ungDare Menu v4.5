local s=""
local a="ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
local m={} for i=1,64 do m[string.byte(a,i)]=i-1 end
local c,byte,f=string.char,string.byte,math.floor local t={} local n=0
for i=1,#s,4 do local x,y,z,w=byte(s,i,i+3) local v=m[x]*262144+m[y]*4096+(m[z] or 0)*64+(m[w] or 0) n=n+1 if w==61 then if z==61 then t[n]=c(f(v/65536)) else t[n]=c(f(v/65536),f(v/256)%256) end else t[n]=c(f(v/65536),f(v/256)%256,v%256) end end
return assert(loadstring(table.concat(t)))()
