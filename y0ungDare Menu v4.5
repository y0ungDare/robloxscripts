 if A:sub(i+2,i+2)=="=" then D[n]=string.char(math.floor(x/65536)%256)
 elseif A:sub(i+3,i+3)=="=" then D[n]=string.char(math.floor(x/65536)%256,math.floor(x/256)%256)
 else D[n]=string.char(math.floor(x/65536)%256,math.floor(x/256)%256,x%256) end
end
local F,E=(loadstring or load)(table.concat(D))
if not F then error(E) end
