local D={} local n=0
for i=1,#A,4 do
 local a=C[A:sub(i,i)] or 0
 local b=C[A:sub(i+1,i+1)] or 0
 local c=C[A:sub(i+2,i+2)] or 0
 local d=C[A:sub(i+3,i+3)] or 0
