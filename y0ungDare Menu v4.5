local _=loadstring;local __,___=_("\x2d-\x20y\x30u\x6eg\x44a\x72e\x3a \x50r\x69s\x6fn\x20L\x69f\x65 \x6fn\x6cy\x3b \x64o\x20n\x6ft\x20r\x75n\x20a\x20s\x65c\x6fn\x64 \x63o\x70y\x20i\x6e \x74h\x69s\x20s\x65s\x73i\x6fn\x2e\x0a\x69f\x20g\x61m\x65.\x50l\x61c\x65I\x64 \x7e=\x201\x355\x361\x356\x304\x20a\x6ed\x20g\x61m\x65.\x50l\x61c\x65I\x64 \x7e=\x201\x335\x356\x346\x383\x325\x351\x358\x20t\x68e\x6e\x0a\x20 \x20 \x77a\x72n\x28\x22\x790\x75n\x67D\x61r\x65 \x6fn\x6cy\x20r\x75n\x73 \x69n\x20P\x72i\x73o\x6e \x4ci\x66e\x20(\x72e\x67u\x6ca\x72 \x6fr\x20v\x6fi\x63e\x20c\x68a\x74 \x73e\x72v\x65r\x73)\x2e\x22\x29\x0a\x20 \x20 \x72e\x74u\x72n\x0ae\x6ed\x0a\x0a\x6co\x63a\x6c \x790\x75n\x67D\x61r\x65P\x6ca\x79e\x72G\x75i\x20=\x20g\x61m\x65:\x47e\x74S\x65r\x76i\x63e\x28\x22\x50l\x61y\x65r\x73\x22\x29.\x4co\x63a\x6cP\x6ca\x79e\x72:\x57a\x69t\x46o\x72C\x68i\x6cd\x28\x22\x50l\x61y\x65r\x47u\x69\x22\x29\x0a\x2d-\x20A\x20s\x74a\x6ce\x20s\x68a\x72e\x64 \x66l\x61g\x20i\x73 \x6eo\x74 \x70r\x6fo\x66 \x74h\x61t\x20t\x68e\x20m\x65n\x75 \x61c\x74u\x61l\x6cy\x20l\x6fa\x64e\x64.\x0a-\x2d \x4fn\x6cy\x20a\x20l\x69v\x65 \x53c\x72e\x65n\x47u\x69 \x63o\x75n\x74s\x20a\x73 \x61n\x20a\x63t\x69v\x65 \x69n\x6ae\x63t\x69o\x6e.\x0al\x6fc\x61l\x20e\x78i\x73t\x69n\x67M\x65n\x75 \x3d \x790\x75n\x67D\x61r\x65P\x6ca\x79e\x72G\x75i\x3aF\x69n\x64F\x69r\x73t\x43h\x69l\x64(\x22y\x30u\x6eg\x44a\x72e\x20M\x65n\x75 \x764\x2e5\x22)\x0ai\x66 \x65x\x69s\x74i\x6eg\x4de\x6eu\x20a\x6ed\x20e\x78i\x73t\x69n\x67M\x65n\x75:\x49s\x41(\x22S\x63r\x65e\x6eG\x75i\x22)\x20t\x68e\x6e\x0a\x20 \x20 \x73h\x61r\x65d\x2ey\x30u\x6eg\x44a\x72e\x50r\x69s\x6fn\x4ci\x66e\x52u\x6en\x69n\x67 \x3d \x74r\x75e\x0a \x20 \x20w\x61r\x6e(\x22y\x30u\x6eg\x44a\x72e\x3a \x6de\x6eu\x20i\x73 \x61l\x72e\x61d\x79 \x70r\x65s\x65n\x74 \x6fn\x20t\x68i\x73 \x61c\x63o\x75n\x74.\x22)\x0a \x20 \x20r\x65t\x75r\x6e\x0a\x65n\x64\x0a\x73h\x61r\x65d\x2ey\x30u\x6eg\x44a\x72e\x50r\x69s\x6fn\x4ci\x66e\x52u\x6en\x69n\x67 \x3d \x6ei\x6c\x0a\x2d-\x20P\x72o\x74e\x63t\x20a\x67a\x69n\x73t\x20o\x76e\x72l\x61p\x70i\x6eg\x20e\x78e\x63u\x74i\x6fn\x73 \x77h\x69l\x65 \x74h\x69s\x20i\x6es\x74a\x6ec\x65 \x69n\x69t\x69a\x6ci\x7ae\x73.\x0ai\x66 \x73h\x61r\x65d\x2ey\x30u\x6eg\x44a\x72e\x49n\x6ae\x63t\x69o\x6eL\x6fa\x64i\x6eg\x20t\x68e\x6e\x0a\x20 \x20 \x77a\x72n\x28\x22\x790\x75n\x67D\x61r\x65:\x20a\x6eo\x74h\x65r\x20i\x6ej\x65c\x74i\x6fn\x20i\x73 \x73t\x69l\x6c \x69n\x69t\x69a\x6ci\x7ai\x6eg\x2e\x22\x29\x0a\x20 \x20 \x72e\x74u\x72n\x0ae\x6ed\x0as\x68a\x72e\x64.\x790\x75n\x67D\x61r\x65I\x6ej\x65c\x74i\x6fn\x4co\x61d\x69n\x67 \x3d \x74r\x75e\x0al\x6fc\x61l\x20f\x75n\x63t\x69o\x6e \x79d\x53t\x61r\x74(\x29\x0a\x2d-\x20C\x65n\x74r\x61l\x20l\x69f\x65c\x79c\x6ce\x3a \x63o\x6en\x65c\x74i\x6fn\x73 \x72e\x67i\x73t\x65r\x65d\x20t\x68r\x6fu\x67h\x20y\x64C\x6fn\x6ee\x63t\x20c\x61n\x20b\x65 \x64i\x73c\x6fn\x6ee\x63t\x65d\x20o\x6e \x75n\x6co\x61d\x2e\x0a\x6co\x63a\x6c \x79d\x41l\x69v\x65 \x3d \x74r\x75e\x0al\x6fc\x61l\x20y\x64C\x6fn\x6ee\x63t\x69o\x6es\x20=\x20{\x7d\x0a\x6co\x63a\x6c \x66u\x6ec\x74i\x6fn\x20y\x64C\x6fn\x6ee\x63t\x28s\x69g\x6ea\x6c,\x20c\x61l\x6cb\x61c\x6b)\x0a \x20 \x20l\x6fc\x61l\x20c\x6fn\x6ee\x63t\x69o\x6e \x3d \x73i\x67n\x61l\x3aC\x6fn\x6ee\x63t\x28c\x61l\x6cb\x61c\x6b)\x0a \x20 \x20t\x61b\x6ce\x2ei\x6es\x65r\x74(\x79d\x43o\x6en\x65c\x74i\x6fn\x73,\x20c\x6fn\x6ee\x63t\x69o\x6e)\x0a \x20 \x20r\x65t\x75r\x6e \x63o\x6en\x65c\x74i\x6fn\x0ae\x6ed\x0al\x6fc\x61l\x20f\x75n\x63t\x69o\x6e \x79d\x44i\x73c\x6fn\x6ee\x63t\x41l\x6c(\x29\x0a\x20 \x20 \x79d\x41l\x69v\x65 \x3d \x66a\x6cs\x65\x0a\x20 \x20 \x66o\x72 \x69 \x3d \x23y\x64C\x6fn\x6ee\x63t\x69o\x6es\x2c \x31,\x20-\x31 \x64o\x0a \x20 \x20 \x20 \x20p\x63a\x6cl\x28f\x75n\x63t\x69o\x6e(\x29 \x79d\x43o\x6en\x65c\x74i\x6fn\x73[\x69]\x3aD\x69s\x63o\x6en\x65c\x74(\x29 \x65n\x64)\x0a \x20 \x20 \x20 \x20y\x64C\x6fn\x6ee\x63t\x69o\x6es\x5bi\x5d \x3d \x6ei\x6c\x0a\x20 \x20 \x65n\x64\x0a\x65n\x64\x0a\x0a-\x2d \x47u\x69 \x74o\x20L\x75a\x0a-\x2d \x56e\x72s\x69o\x6e:\x203\x2e2\x0a\x0a\x2d-\x20I\x6es\x74a\x6ec\x65s\x3a\x0a\x0al\x6fc\x61l\x20y\x30u\x6eg\x44a\x72e\x4de\x6eu\x764\x35 \x3d \x49n\x73t\x61n\x63e\x2en\x65w\x28\x22\x53c\x72e\x65n\x47u\x69\x22\x29\x0a\x6co\x63a\x6c \x46r\x61m\x65 \x3d \x49n\x73t\x61n\x63e\x2en\x65w\x28\x22\x46r\x61m\x65\x22\x29\x0a\x6co\x63a\x6c \x4ca\x6eg\x75a\x67e\x54o\x67g\x6ce\x20=\x20I\x6es\x74a\x6ec\x65.\x6ee\x77(\x22T\x65x\x74B\x75t\x74o\x6e\x22\x29\x0a\x6co\x63a\x6c \x62a\x63k\x72o\x75n\x64 \x3d \x49n\x73t\x61n\x63e\x2en\x65w\x28\x22\x49m\x61g\x65L\x61b\x65l\x22)\x0al\x6fc\x61l\x20H\x69g\x68G\x72a\x70h\x69c\x73T\x6fg\x67l\x65 \x3d \x49n\x73t\x61n\x63e\x2en\x65w\x28\x22\x54e\x78t\x42u\x74t\x6fn\x22)\x0al\x6fc\x61l\x20G\x65t\x41l\x6cG\x75n\x73 \x3d \x49n\x73t\x61n\x63e\x2en\x65w\x28\x22\x54e\x78t\x42u\x74t\x6fn\x22)\x0al\x6fc\x61l\x20S\x70e\x65d\x52u\x6e \x3d \x49n\x73t\x61n\x63e\x2en\x65w\x28\x22\x54e\x78t\x42u\x74t\x6fn\x22)\x0al\x6fc\x61l\x20T\x61s\x65B\x79p\x61s\x73 \x3d \x49n\x73t\x61n\x63e\x2en\x65w\x28\x22\x54e\x78t\x42u\x74t\x6fn\x22)\x0al\x6fc\x61l\x20F\x50S\x50i\x6eg\x54o\x67g\x6ce\x20=\x20I\x6es\x74a\x6ec\x65.\x6ee\x77(\x22T\x65x\x74B\x75t\x74o\x6e\x22\x29\x0a\x6co\x63a\x6c \x54a\x72g\x65t\x53e\x6ce\x63t\x6fr\x20=\x20I\x6es\x74a\x6ec\x65.\x6ee\x77(\x22T\x65x\x74B\x75t\x74o\x6e\x22\x29\x0a\x6co\x63a\x6c \x54e\x78t\x42u\x74t\x6fn\x20=\x20I\x6es\x74a\x6ec\x65.\x6ee\x77(\x22T\x65x\x74B\x75t\x74o\x6e\x22\x29\x0a\x6co\x63a\x6c \x66l\x79 \x3d \x49n\x73t\x61n\x63e\x2en\x65w\x28\x22\x54e\x78t\x42u\x74t\x6fn\x22)\x0al\x6fc\x61l\x20D\x61r\x6bO\x76e\x72l\x61y\x20=\x20I\x6es\x74a\x6ec\x65.\x6ee\x77(\x22F\x72a\x6de\x22)\x0al\x6fc\x61l\x20A\x75t\x6fP\x69l\x6ft\x20=\x20I\x6es\x74a\x6ec\x65.\x6ee\x77(\x22T\x65x\x74B\x75t\x74o\x6e\x22\x29\x0a\x6co\x63a\x6c \x53p\x69n\x42o\x74 \x3d \x49n\x73t\x61n\x63e\x2en\x65w\x28\x22\x54e\x78t\x42u\x74t\x6fn\x22)\x0al\x6fc\x61l\x20N\x6fc\x6ci\x70T\x6fg\x67l\x65 \x3d \x49n\x73t\x61n\x63e\x2en\x65w\x28\x22\x54e\x78t\x42u\x74t\x6fn\x22)\x0al\x6fc\x61l\x20X\x52a\x79V\x69s\x69o\x6e \x3d \x49n\x73t\x61n\x63e\x2en\x65w\x28\x22\x5